[Unit]
Description=Timer for reMarkable HWR sync-recent (awake interval from SYNC_INTERVAL_MINUTES)

[Timer]
# Monotonic time pauses while the tablet is suspended. A short interval therefore
# means "within 15 awake minutes" without waking the tablet or draining battery.
OnBootSec=5min
OnUnitActiveSec=15min
AccuracySec=1min
Unit=hwr-sync-recent.service

[Install]
WantedBy=timers.target
