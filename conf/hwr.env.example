# Copy to /home/root/hwr/conf/hwr.env on the tablet and chmod 0600.
# Do NOT commit a filled-in hwr.env.
#
# Sign up / get keys: https://developer.myscript.com/
# APP_KEY required only when UPLOAD_MODE is text or both (leave empty for svg).
# HMAC_KEY optional if HMAC is disabled in the dashboard.

APP_KEY=
HMAC_KEY=
LANG=en_US
CONTENT_TYPE=Text
API_URL=https://cloud.myscript.com/api/v4.0/iink/batch
UPLOAD_MODE=both   # text | svg | both
# Default when unset in existing installs: text (backward compatible).
# Fresh installs via install-rm2-stack.ps1 default to both.

# Poll interval in awake minutes (installer default: 15; 0 = disable timer).
# Suspend time does not count, so this does not wake the tablet or consume sleep battery.
SYNC_INTERVAL_MINUTES=15

# Joplin notebook for NEW notes lives in jonobones.env (JONOBONES_PARENT_ID / JONOBONES_PARENT_TITLE),
# not here. Blank/unset = auto most-notes. See conf/jonobones.env.example.
