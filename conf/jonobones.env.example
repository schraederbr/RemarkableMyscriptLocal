# Optional overrides for scripts/joplin-upsert.js / installer
# JONOBONES_URL=http://127.0.0.1:26637/v1
# JONOBONES_TOKEN=
# JONOBONES_PARENT_ID=
# JONOBONES_PARENT_TITLE=
# JONOBONES_PROFILE=/home/root/.config/jonobones/default
#
# Parent for NEW notes only (updates match by title anywhere):
# - Leave both PARENT_* unset = auto-pick notebook with the most notes at create time
# - Or set JONOBONES_PARENT_ID to a 32-hex notebook id
# - Or set JONOBONES_PARENT_TITLE to an exact notebook title (resolved at create time)
