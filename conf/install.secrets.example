# Copy to conf/install.secrets (gitignored) or let install-rm2-stack.ps1 write it.
# Never commit real values. See docs/install-checklist.md.

HOST=10.11.99.1
SSH_USER=root
# Used once to install your PC SSH key; leave blank if key auth already works
SSH_PASSWORD=

# Joplin upload mode first: text | svg | both (installer default: both)
# SVG-only skips MyScript key prompts.
UPLOAD_MODE=both
# MyScript (developer.myscript.com) — required only for text|both
APP_KEY=
HMAC_KEY=
LANG=en_US
# Awake minutes between sync-recent checks (default 15; 0 disables timer)
SYNC_INTERVAL_MINUTES=15
# Optional XOVI/AppLoad UI + Sync Joplin shortcut (default 0/off).
# Interactive only; supported on reMarkable 2 firmware 3.26.x-3.27.x.
INSTALL_APPLOAD=0
# Joplin notebook for NEW notes: blank/omit = auto (most notes). Or 32-hex id / exact title.
# JONOBONES_PARENT_ID=
# JONOBONES_PARENT_TITLE=


# Joplin: joplinCloud | webdav | nextcloud | joplinServer
SYNC_TARGET=joplinCloud
JOPLIN_EMAIL=
JOPLIN_PASSWORD=

# Only if the vault uses E2EE (leave blank to skip)
E2EE_MASTER_PASSWORD=

# For webdav/nextcloud/joplinServer instead of Cloud:
# SYNC_URL=
# SYNC_USERNAME=
# SYNC_PASSWORD=

OVERWRITE_JONOBONES_CONFIG=y
SKIP_JONOBONES_INIT=0
START_JONOBONES=1
