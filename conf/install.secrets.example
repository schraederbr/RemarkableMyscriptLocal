# Copy to conf/install.secrets (gitignored) or let install-rm2-stack.ps1 write it.
# Never commit real values. See docs/install-checklist.md.

HOST=10.11.99.1
SSH_USER=root
# Used once to install your PC SSH key; leave blank if key auth already works
SSH_PASSWORD=

# MyScript (developer.myscript.com)
APP_KEY=
HMAC_KEY=
LANG=en_US

# Joplin: joplinCloud | webdav | nextcloud | joplinServer
SYNC_TARGET=joplinCloud
JOPLIN_EMAIL=
JOPLIN_PASSWORD=

# Only if the vault uses E2EE (leave blank to skip)
E2EE_MASTER_PASSWORD=

# For webdav/nextcloud/joplinServer instead of Cloud:
# SYNC_URL=
# SYNC_USERNAME=
# SYNC_PASSWORD=

OVERWRITE_JONOBONES_CONFIG=y
SKIP_JONOBONES_INIT=0
START_JONOBONES=1
